# Copy to .env and fill in only what you use. Never commit .env.

# --- Optional API-backed vision / text providers ---
# Used when vision.provider = "anthropic" or llm.provider = "anthropic"
ANTHROPIC_API_KEY=

# Used when vision.provider = "openai_compatible" or llm.provider = "openai_compatible"
# Works with OpenAI, vLLM, Ollama, LM Studio and any OpenAI-compatible server.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Hugging Face ---
# Only needed for gated models. Also controls where local models are cached.
HF_TOKEN=
HF_HOME=

# --- Pipeline overrides (optional, override YAML config) ---
# VIDEO_DATASET_CONFIG=config/default.yaml
# VIDEO_DATASET_DATA_DIR=data
# VIDEO_DATASET_DEVICE=auto          # auto | cuda | mps | cpu
# VIDEO_DATASET_LOG_LEVEL=INFO
# YT_DLP_COOKIES=                    # path to a cookies file if the videos you are authorized to process need auth
